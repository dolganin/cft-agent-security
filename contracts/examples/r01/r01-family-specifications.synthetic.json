  "deficiency_codes": {
    "not_synthetic": "facts are not marked synthetic contract examples",
    "missing_required_facts": "a fact required for a confirm/reject decision is absent",
    "positive_control_not_passed": "the operator positive control did not pass",
    "positive_control_missing": "no positive control was recorded",
    "negative_control_not_enforced": "the separate negative control was not recorded as denied/enforced",
    "negative_control_missing": "no negative control was recorded",
    "trial_count_insufficient": "fewer than two repeated trials after operator reset",
    "binding_mismatch": "target/service/endpoint/snapshot/action binding facts do not match",
    "artifact_roles_incomplete": "execution, audit and source artifacts are not all present",
    "cleanup_incomplete": "baseline restore, session revocation or side-effect check failed",
    "truncated_output": "output was truncated or partial",
    "insufficient_basis": "result distinguishable only by HTTP status, reflection or token-shaped value",
    "ambiguous_owner": "object ownership is unproved, ambiguous or shared",
    "identity_unverified": "the server-observed principal could not be independently established",
    "ambiguous_normalization": "the parsed Location cannot be canonicalized unambiguously",
    "redirect_followed": "any evidence that the redirect destination was contacted",
    "not_evaluated": "only literal reflection was observed; evaluation is not established",
    "missing_permission_proof": "the permission/denial basis is not proved for the claim",
    "unexpected_trial_result": "trial outcomes are inconsistent with the claimed verdict",
    "unsupported_verdict": "a non-terminal verdict is not permitted"
  },
  "mutation_kinds": {
    "missing_negative_control": "set the family negative-control fact to not_run",
    "drop_negative_control_fact": "remove the family negative-control fact entirely",
    "no_repeat": "reduce trials_after_reset to 1",
    "binding_mismatch": "set binding_match false and target_id to a different synthetic id",
    "ambiguous_owner": "set owner manifest/proof facts false or unknown",
    "status_only": "mark the result distinguishable only by status/reflection",
    "reflection_only": "mark the code marker as reflected without evaluation"
  }
}
