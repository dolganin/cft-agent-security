        "server_observed_role_id",
        "role_a_allowed_control_passed",
        "negative_control_denied",
        "unauthorized_effect_observed",
        "effect_marker_observed_each_trial",
        "trial_outcome_denied_or_absent",
        "identity_proof_established",
        "permission_denial_proved",
        "privilege_state_changed"
      ],
      "positive_control_fact": "positive_control",
      "negative_control_fact": "negative_control",
      "trial_outcome_fact": "trial_outcome_denied_or_absent",
      "unauthorized_effect_fact": "unauthorized_effect_observed",
      "effect_marker_fact": "effect_marker_observed_each_trial",
