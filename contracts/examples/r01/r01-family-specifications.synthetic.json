        {"id": "sc-a-self", "class": "session_wiring_and_baseline_read", "applies_to": "both", "count": 1},
        {"id": "nc-a-anon", "class": "authentication_negative_control", "applies_to": "authn-only", "count": 1},
        {"id": "nc-a-different", "class": "authorization_negative_control_distinct_operation", "applies_to": "authz-only", "count": 1},
        {"id": "sc-a-allowed", "class": "authorization_wiring_control", "applies_to": "authz-only", "count": 1},
        {"id": "probe-a-t1", "class": "trial_unauthorized_attempt", "applies_to": "both", "count": 1},
        {"id": "probe-a-t2", "class": "trial_unauthorized_attempt_after_operator_reset", "applies_to": "both", "count": 1},
