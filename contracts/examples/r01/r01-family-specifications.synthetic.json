{
  "schema": "r01-family-specifications/contract-fixture-v1",
  "synthetic": true,
  "contract_fixture_only": true,
  "not_ground_truth": true,
  "production_tool_registered": false,
  "conformance_evaluator": "tests/test_r01_specifications.py",
  "evaluator_kind": "test_only_not_production_evidence_model",
  "docs_reference": "docs/r01-verification-specifications.md",
  "common": {
    "common_max_http_exchanges": 8,
    "max_exchange_counted_classes": [
      "local http test-service exchange",
      "container evaluation invocation (R01-CODE)"
    ],
    "operator_reset_note": "Resets run through the pinned operator reset adapter (fixture reload/reseed, session revocation, container destruction) and are never unreviewed model writes; adapter invocations are not HTTP exchanges, but every verification read they require is counted.",
    "mandatory_controls": ["positive_control", "negative_control"],
    "control_separation_rule": "positive control, negative control and the candidate probe are distinct requests; no single request may simultaneously expect a denial and an unauthorized success",
    "min_required_trials": 2,
    "required_artifact_roles": ["execution", "audit", "source"],
    "binding_fields": ["scope.target==facts.target_id", "scope.service==facts.service_id", "facts.source_snapshot_id", "facts.endpoint_id", "action_id==action.id"],
    "shared_required_facts": [
      "synthetic",
      "target_id",
      "service_id",
      "endpoint_id",
      "source_snapshot_id",
      "fixture_id",
      "role_a_id",
      "role_b_id",
      "claim_id",
      "role_a_permission",
      "normal_output_control_passed",
      "positive_control",
      "negative_control",
      "trials_after_reset",
      "binding_match",
      "cleanup_baseline_restored",
      "cleanup_sessions_revoked",
      "output_truncated",
      "distinguishable_only_by_status_or_reflection",
      "side_effects_unexplained"
    ],
    "insufficient_basis_fact": "distinguishable_only_by_status_or_reflection"
  },
  "families": [
    {
      "id": "R01-OWN-READ",
      "observation_kind": "r01_ownership_read_observation_v1",
      "claims": ["cross_owner_read"],
      "permission_proof_required_for": "always",
      "budget": {
        "max_http_exchanges": 7,
        "reserved_capacity": 0,
        "is_family_specific_above_common": false,
        "basis": "controls, baseline, two trials and cleanup verification fit a budget tighter than the common default; tightened bounds are explicit, never a loosening"
      },
      "exchanges": [
        {"id": "oc-r-read", "class": "positive_control", "count": 1},
        {"id": "nc-r-deny", "class": "negative_security_control", "count": 1},
        {"id": "sc-r-self", "class": "session_wiring_control", "count": 1},
        {"id": "baseline-r-digest", "class": "baseline_proof_read", "count": 1},
        {"id": "probe-r-t1", "class": "trial_probe", "count": 1},
        {"id": "probe-r-t2", "class": "trial_probe_after_operator_reset", "count": 1},
        {"id": "cleanup-r-verify", "class": "cleanup_verification_read", "count": 1}
      ],
      "family_required_facts_for_confirm_or_reject": [
        "object_a_id",
        "object_b_id",
        "negative_control_object_id",
        "baseline_object_version_digest",
        "object_b_owner_manifest_verified",
        "role_a_own_control_passed",
        "owner_proved_from_manifest",
        "identity_proof_established",
        "permission_denial_proved",
        "unauthorized_effect_observed",
        "effect_marker_observed_each_trial",
        "trial_outcome_denied_or_absent"
      ],
      "positive_control_fact": "positive_control",
      "negative_control_fact": "negative_control",
      "trial_outcome_fact": "trial_outcome_denied_or_absent",
      "unauthorized_effect_fact": "unauthorized_effect_observed",
      "effect_marker_fact": "effect_marker_observed_each_trial",
      "mutations_applicable": [
        "missing_negative_control",
        "drop_negative_control_fact",
        "no_repeat",
        "binding_mismatch",
        "ambiguous_owner",
        "status_only"
      ],
      "examples": {
        "confirmed": "evidence-owned-read-confirmed.synthetic.json",
        "rejected": "evidence-owned-read-rejected.synthetic.json",
        "inconclusive": "evidence-owned-read-inconclusive.synthetic.json"
      },
      "inconclusive_expected_deficiencies": ["ambiguous_owner"]
    },
    {
